# Copy to marketing/.env for posting from your own machine. marketing/.env is git-ignored.
# Leave a platform's lines empty to skip that platform.

# Bluesky: Settings > Privacy and security > App passwords
BLUESKY_HANDLE=quill.bsky.social
BLUESKY_APP_PASSWORD=

# Mastodon: Preferences > Development > New application
MASTODON_URL=https://mastodon.social
MASTODON_TOKEN=

# Instagram: Meta developer app > Instagram API with Instagram login > Generate access tokens
INSTAGRAM_TOKEN=

# Threads: Meta developer app > Access the Threads API (see README, or run `threads-token`)
THREADS_TOKEN=

# Only needed for the one-time `threads-token` helper
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://github.com/MohammadAliUstad/Quill
