<!--
    ABOUT SCREEN ANIMATED VECTOR — Amatyaa Quill Icon (tap-to-replay)
    ───────────────────────────────────────────────────────────────
    Colors:
      Outer feather : #F5EDD6  (Antique Ivory) — also used as the trace stroke
      Inner vane    : #E5B830  (gold)

    Animation sequence (total ~1900ms):
      150 – 1150ms: outside and inside of the border trace at the same time
                    (trimPathEnd 0→1 on both stroke paths, in parallel)
      1100 – 1900ms: once both traces finish, the border fill and the vane
                    fill color both fade in together, traced strokes fade out

    Rest pose (before any tap) is the FINISHED icon — trimPathEnd/fillAlpha
    are declared at their end-of-animation values below, so the icon shows
    normally as soon as the About screen opens. Tapping calls Animatable
    .start(), which resets every animator to its valueFrom and replays.

    The border trace is split into two separate stroke-only paths (outer
    contour + inner swirl) so each subpath draws as one continuous sweep
    instead of jumping mid-animation, while both run in parallel so it
    reads as a single pen tracing the whole border at once.

    Requires:
      android:fillType="evenOdd" / trimPath* → API 24+ (Android 7.0)
      For older devices use VectorDrawableCompat from AndroidX.
-->
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="512"
            android:viewportHeight="512">

            <!--
                Scale bridge: quill SVG is in a 24×24 coordinate space, drawn
                into a virtual 27×27 box (1.5-unit safe-area margin on every
                side) so the trace stroke and its miter spikes at the sharp
                nib tip have room to render without being clipped by the
                viewport bounds. 18.963 = 512 ÷ 27; 28.444 = 1.5 × 18.963.
            -->
            <group
                android:scaleX="18.963"
                android:scaleY="18.963"
                android:translateX="28.444"
                android:translateY="28.444">

                <!--
                    LAYER 1 — Inner vane (solid fill, sits behind the feather)
                    Rest pose is fully filled; tapping resets to 0 and replays.
                -->
                <path
                    android:name="inner_vane"
                    android:fillAlpha="1"
                    android:fillColor="#E5B830"
                    android:pathData="M22.8013 1.74899C22.6665 1.22946 22.1457 0.908925 21.6212 1.02275C8.65054 3.83745 2.58949 13.7685 0.052924 22.7276C-0.0695134 23.16 0.111594 23.621 0.495639 23.8545C0.671767 23.9616 0.870732 24.0087 1.06614 23.9987C1.30094 22.8623 2.3183 22.0061 3.53976 22L3.82845 21.7288C4.23095 21.3506 4.25066 20.7177 3.87248 20.3153C3.65552 20.0843 3.35472 19.9794 3.06169 20.0033L3.10053 19.9025C3.13285 19.8568 3.16175 19.8078 3.18671 19.7556C3.39169 19.327 3.62105 19.0828 3.85127 18.9282C4.08827 18.769 4.38857 18.663 4.7947 18.6054C5.20936 18.5467 5.69118 18.5437 6.27396 18.5637C6.4627 18.5702 6.66791 18.5794 6.8832 18.5891C7.29482 18.6077 7.74319 18.6279 8.18371 18.6335C9.57215 18.6515 11.1777 18.5382 12.8464 17.8022C14.5236 17.0625 16.1803 15.7318 17.7487 13.451C17.9918 13.0974 17.9823 12.6281 17.7249 12.2846C17.6946 12.2443 17.6617 12.2067 17.6266 12.1721C18.6722 11.5802 19.5909 10.7793 20.3487 9.88147C21.3629 8.6798 22.1246 7.27154 22.5618 5.86914C22.9956 4.47728 23.1309 3.02041 22.8013 1.74899Z"/>

                <!--
                    LAYER 2 — Outer feather (evenOdd punches out the inner vane,
                    letting the golden layer show through).
                    Fill only — the border is traced by the two stroke-only
                    paths below, and this fades in once they finish.
                    Requires API 24+ for fillType="evenOdd".
                -->
                <path
                    android:name="outer_feather"
                    android:fillColor="#F5EDD6"
                    android:fillAlpha="1"
                    android:fillType="evenOdd"
                    android:pathData="M22.8013 1.74899C22.6665 1.22946 22.1457 0.908925 21.6212 1.02275C8.65054 3.83745 2.58949 13.7685 0.052924 22.7276C-0.0695134 23.16 0.111594 23.621 0.495639 23.8545C0.671767 23.9616 0.870732 24.0087 1.06614 23.9987C1.30094 22.8623 2.3183 22.0061 3.53976 22L3.82845 21.7288C4.23095 21.3506 4.25066 20.7177 3.87248 20.3153C3.65552 20.0843 3.35472 19.9794 3.06169 20.0033L3.10053 19.9025C3.13285 19.8568 3.16175 19.8078 3.18671 19.7556C3.39169 19.327 3.62105 19.0828 3.85127 18.9282C4.08827 18.769 4.38857 18.663 4.7947 18.6054C5.20936 18.5467 5.69118 18.5437 6.27396 18.5637C6.4627 18.5702 6.66791 18.5794 6.8832 18.5891L6.88328 18.5891C7.29482 18.6077 7.74319 18.6279 8.18371 18.6335C9.57215 18.6515 11.1777 18.5382 12.8464 17.8022C14.5236 17.0625 16.1803 15.7318 17.7487 13.451C17.9918 13.0974 17.9823 12.6281 17.7249 12.2846C17.6946 12.2443 17.6617 12.2067 17.6266 12.1721C18.6722 11.5802 19.5909 10.7793 20.3487 9.88147C21.3629 8.6798 22.1246 7.27154 22.5618 5.86914C22.9956 4.47728 23.1309 3.02041 22.8013 1.74899ZM6.34251 16.5649C5.75764 16.5449 5.15144 16.5409 4.57221 16.6173C7.63752 10.6611 12.7418 5.34921 20.9846 3.22857C20.9893 3.84429 20.8812 4.53976 20.6524 5.27392C20.2948 6.42083 19.663 7.59302 18.8203 8.59148C17.1301 10.5941 14.7335 11.7666 12.0659 10.9528C11.6664 10.8309 11.2332 10.9702 10.9795 11.3021C10.7259 11.634 10.7053 12.0885 10.9278 12.442C11.5713 13.4641 12.8696 14.1643 14.5192 14.2379C13.6686 15.0806 12.8349 15.6214 12.0393 15.9723C10.7466 16.5425 9.46928 16.65 8.20953 16.6337C7.79588 16.6284 7.41308 16.611 7.02596 16.5934H7.02595C6.80185 16.5832 6.57631 16.5729 6.34251 16.5649Z"/>

                <!--
                    LAYER 3 — Trace-only strokes (no fill).
                    Two separate paths so each subpath's trimPathEnd runs as
                    one uninterrupted sweep, then both fade out once the
                    real fill (layer 2) takes over.
                -->
                <path
                    android:name="trace_outer_contour"
                    android:fillAlpha="0"
                    android:strokeColor="#F5EDD6"
                    android:strokeWidth="0.55"
                    android:strokeAlpha="0"
                    android:strokeLineCap="butt"
                    android:strokeLineJoin="miter"
                    android:strokeMiterLimit="4"
                    android:trimPathStart="0"
                    android:trimPathEnd="1"
                    android:pathData="M22.8013 1.74899C22.6665 1.22946 22.1457 0.908925 21.6212 1.02275C8.65054 3.83745 2.58949 13.7685 0.052924 22.7276C-0.0695134 23.16 0.111594 23.621 0.495639 23.8545C0.671767 23.9616 0.870732 24.0087 1.06614 23.9987C1.30094 22.8623 2.3183 22.0061 3.53976 22L3.82845 21.7288C4.23095 21.3506 4.25066 20.7177 3.87248 20.3153C3.65552 20.0843 3.35472 19.9794 3.06169 20.0033L3.10053 19.9025C3.13285 19.8568 3.16175 19.8078 3.18671 19.7556C3.39169 19.327 3.62105 19.0828 3.85127 18.9282C4.08827 18.769 4.38857 18.663 4.7947 18.6054C5.20936 18.5467 5.69118 18.5437 6.27396 18.5637C6.4627 18.5702 6.66791 18.5794 6.8832 18.5891L6.88328 18.5891C7.29482 18.6077 7.74319 18.6279 8.18371 18.6335C9.57215 18.6515 11.1777 18.5382 12.8464 17.8022C14.5236 17.0625 16.1803 15.7318 17.7487 13.451C17.9918 13.0974 17.9823 12.6281 17.7249 12.2846C17.6946 12.2443 17.6617 12.2067 17.6266 12.1721C18.6722 11.5802 19.5909 10.7793 20.3487 9.88147C21.3629 8.6798 22.1246 7.27154 22.5618 5.86914C22.9956 4.47728 23.1309 3.02041 22.8013 1.74899Z"/>

                <path
                    android:name="trace_inner_swirl"
                    android:fillAlpha="0"
                    android:strokeColor="#F5EDD6"
                    android:strokeWidth="0.55"
                    android:strokeAlpha="0"
                    android:strokeLineCap="butt"
                    android:strokeLineJoin="miter"
                    android:strokeMiterLimit="4"
                    android:trimPathStart="0"
                    android:trimPathEnd="1"
                    android:pathData="M6.34251 16.5649C5.75764 16.5449 5.15144 16.5409 4.57221 16.6173C7.63752 10.6611 12.7418 5.34921 20.9846 3.22857C20.9893 3.84429 20.8812 4.53976 20.6524 5.27392C20.2948 6.42083 19.663 7.59302 18.8203 8.59148C17.1301 10.5941 14.7335 11.7666 12.0659 10.9528C11.6664 10.8309 11.2332 10.9702 10.9795 11.3021C10.7259 11.634 10.7053 12.0885 10.9278 12.442C11.5713 13.4641 12.8696 14.1643 14.5192 14.2379C13.6686 15.0806 12.8349 15.6214 12.0393 15.9723C10.7466 16.5425 9.46928 16.65 8.20953 16.6337C7.79588 16.6284 7.41308 16.611 7.02596 16.5934H7.02595C6.80185 16.5832 6.57631 16.5729 6.34251 16.5649Z"/>

            </group>

        </vector>
    </aapt:attr>

    <!-- ── ANIMATION 1 ── trace_outer_contour: draws first (100 – 550ms) ── -->
    <target android:name="trace_outer_contour">
        <aapt:attr name="android:animation">
            <set android:ordering="together">

                <objectAnimator
                    android:propertyName="trimPathEnd"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="1000"
                    android:startOffset="150"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>

                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:valueFrom="1"
                    android:valueTo="0"
                    android:duration="750"
                    android:startOffset="1100"
                    android:interpolator="@interpolator/emphasized_decelerate"/>

            </set>
        </aapt:attr>
    </target>

    <!-- ── ANIMATION 2 ── trace_inner_swirl: traces at the same time as the outer contour (100 – 750ms) ── -->
    <target android:name="trace_inner_swirl">
        <aapt:attr name="android:animation">
            <set android:ordering="together">

                <objectAnimator
                    android:propertyName="trimPathEnd"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="1000"
                    android:startOffset="150"
                    android:interpolator="@android:interpolator/fast_out_slow_in"/>

                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:valueFrom="1"
                    android:valueTo="0"
                    android:duration="750"
                    android:startOffset="1100"
                    android:interpolator="@interpolator/emphasized_decelerate"/>

            </set>
        </aapt:attr>
    </target>

    <!-- ── ANIMATION 3 ── outer_feather: border fill fades in once both traces finish ── -->
    <target android:name="outer_feather">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="800"
                android:startOffset="1100"
                android:interpolator="@interpolator/emphasized_decelerate"/>
        </aapt:attr>
    </target>

    <!-- ── ANIMATION 4 ── inner_vane: color fill fades in together with the border ── -->
    <target android:name="inner_vane">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="800"
                android:startOffset="1100"
                android:interpolator="@interpolator/emphasized_decelerate"/>
        </aapt:attr>
    </target>

</animated-vector>
