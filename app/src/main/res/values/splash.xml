<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Quill.SplashScreen" parent="Theme.SplashScreen">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_icon</item>

        <item name="windowSplashScreenAnimationDuration">2000</item>

        <!-- The icon's green (#576421) dimmed a little: filling the whole screen, the same green
             reads brighter than it does in the small icon, so it's toned down to look alike. -->
        <item name="android:windowBackground">#48531B</item>
        <item name="windowSplashScreenBackground">#48531B</item>
    </style>

</resources>